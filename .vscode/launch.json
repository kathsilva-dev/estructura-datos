{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Depurar archivo actual",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/${fileBasenameNoExtension}.exe",
            "cwd": "${fileDirname}",
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "setupCommands": [
                { "description": "Mostrar contenedores de forma legible", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ],
            "preLaunchTask": "Solo compilar"
        }
    ]
}
